create Table users(
	user_id Varchar PRIMARY KEY,
	name Varchar(100) NOT NULL,
	email Varchar(50) NOT NULL UNIQUE,
	password Varchar(20) NOT NULL,
	role Varchar NOT NULL,
	is_profile_completed Boolean Default FALSE,
	created_at TIMESTAMP Default CURRENT_TIMESTAMP,
	updated_at TIMESTAMP Default CURRENT_TIMESTAMP
);

select * from users;

delete from users where email='abc@example.com';

alter table users
alter column is_profile_completed SET NOT NULL;

Create Table jobseekers(
	user_id VARCHAR PRIMARY KEY,
	full_name VARCHAR(30) NOT NULL,
	profile_picture VARCHAR(100),
	year_of_experience VARCHAR(20) NOT NULL,
	bio TEXT,
	preferred_roles VARCHAR(100) NOT NULL,
	created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
	updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
	CONSTRAINT fk_jobseekers
	FOREIGN KEY(user_id)
	REFERENCES users(user_id)
	ON DELETE CASCADE
);

select * from jobseekers;
